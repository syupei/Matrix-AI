    {
      "id": "codex-matrix-script",
      "runner": "codex exec",
      "events": [
        {
          "item": {
            "type": "command_execution",
            "command": "/bin/zsh -lc \"python3 kit/matrix/orchestration/tools/pm_tasks.py --help; python3 -c 'import sqlite3; c=sqlite3.connect(\\\"file:management/runtime/tasks.sqlite3?mode=ro\\\",uri=True); print(c.execute(\\\"select name,sql from sqlite_master where type=\\\\\\\"table\\\\\\\"\\\").fetchall())' \""
          }
        }
      ],
      "front_content_dependency": false,
      "matrix_content_dependency": true
    }
  ]
