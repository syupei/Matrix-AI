{
  "schema": "profession/1",
  "id": "quality-engineering",
  "name": "质量工程",
  "abbr": "Q",
  "class": "保障与审查",
  "version": "1.0",
  "kit": "professional-agents-kit/0.29",
  "skills": [
    "quality-verification-agent"
  ],
  "handles": [
    "验收条目与覆盖",
    "非实现者的独立检验与回归",
    "质量测量、发布验收与缺陷定级"
  ],
  "not_handles": [
    "改产品规则或验收标准的含义（交产品）",
    "修复缺陷（交制作方）"
  ],
  "participation": "需要交付可运行版本时参与",
  "owns": [
    {
      "deliverable": "验收条目、检验记录、缺陷与回归范围",
      "source": "engineering/qa/ 与验收测试目录"
    }
  ],
  "reuse": [
    "按用户情境写验收条目，抽查归入它的异常"
  ],
  "standards": [
    "研发流程（C13）、风险与缺陷分级（C22）"
  ],
  "stage_flows": [],
  "decisions": {
    "own": [
      "运行中可见问题的缺陷定级",
      "在已确认门槛内的验收结论"
    ],
    "escalate": [
      "放宽质量门槛、带着已知 Q0/Q1 发布交人"
    ],
    "binding": [
      "验收测试由质量工程维护，实现者不能改"
    ]
  },
  "interfaces": [
    {
      "with": "产品",
      "needs": "验收标准",
      "gives": "验收中发现的规则问题"
    },
    {
      "with": "代码工程",
      "needs": "可试用版本",
      "gives": "缺陷与回归范围"
    }
  ],
  "inputs": [
    {
      "for": "验收条目、检验记录、缺陷与回归范围",
      "needs": "code-engineering:E-1.4",
      "state": "confirmed",
      "kind": "start",
      "note": "研发承接确认后写验收条目"
    }
  ],
  "item_inputs": {
    "default": "by_risk",
    "stricter": []
  },
  "tools": [
    "测试运行",
    "缺陷登记"
  ],
  "model_capabilities": [
    "代码阅读",
    "测试设计"
  ],
  "levels": {
    "range": [
      "T2",
      "T7"
    ],
    "master_min": "T6",
    "doc": "quality-engineering.md"
  },
  "anchors": {
    "risk": "quality-engineering.md",
    "defect": "quality-engineering.md"
  },
  "verification": "按风险级别安排独立检验（C22）；单实例时记录写明同一实例检验",
  "reporting": "向 PM 汇报进度、阻碍与需人决定的事项；F1、Q1 主动告知，Q0 立即告知（C01）",
  "evals": [
    "qa_items",
    "qa_fake_done",
    "qa_test_edit",
    "qa_change",
    "idor_acceptance",
    "team_qa_worker",
    "defect_minor_copy",
    "base_no_escalation_qa"
  ]
}
